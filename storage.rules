rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Certificates folder:
    // Anyone can read/download certificate images and PDFs
    // Only authenticated admin can upload, modify, or delete files
    match /certificates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024 // max 15MB
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
  }
}
