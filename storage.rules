rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is the single authorized owner
    function isSoleAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'jitendrachoudhary1401@gmail.com' ||
        request.auth.uid == 'fHna0rKgAtOPYsFiD6xufpHoLii1'
      );
    }

    // Certificates folder:
    // Anyone can read/download certificate images and PDFs
    // Only the single authorized admin can upload, modify, or delete files
    match /certificates/{allPaths=**} {
      allow read: if true;
      allow write: if isSoleAdmin()
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // General assets and uploads:
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if isSoleAdmin()
                   && request.resource.size < 15 * 1024 * 1024;
    }
  }
}

