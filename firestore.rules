rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is the single authorized owner
    function isSoleAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'jitendrachoudhary1401@gmail.com' ||
        request.auth.uid == 'fHna0rKgAtOPYsFiD6xufpHoLii1'
      );
    }
    
    // Settings, Profile & Portfolio content:
    // Anyone can read (to view public portfolio)
    // Only the single authorized admin can modify
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isSoleAdmin();
    }
    
    // Projects collection:
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isSoleAdmin();
    }
    
    // Certificates collection:
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isSoleAdmin();
    }
    
    // Skills collection:
    match /skills/{document=**} {
      allow read: if true;
      allow write: if isSoleAdmin();
    }
    
    // Services collection:
    match /services/{document=**} {
      allow read: if true;
      allow write: if isSoleAdmin();
    }
    
    // FAQs collection:
    match /faqs/{document=**} {
      allow read: if true;
      allow write: if isSoleAdmin();
    }
    
    // Achievements collection:
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isSoleAdmin();
    }
    
    // Contact inquiries:
    // Anyone can submit an inquiry with valid payload
    // Only the sole admin can read, update, or delete received messages
    match /contacts/{messageId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if isSoleAdmin();
    }
  }
}

